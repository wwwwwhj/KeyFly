{
  "name": "keyfly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node --env-file-if-exists=.env --experimental-strip-types server/index.ts --dev",
    "start:server": "node --env-file-if-exists=.env --experimental-strip-types server/index.ts",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build": "tsc --noEmit && vite build",
    "package": "npm run build && node --env-file-if-exists=.env scripts/package.mjs"
  },
  "dependencies": {
    "@discourse-mini-app/sdk": "file:vendor/sdk",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  },
  "engines": { "node": ">=24" }
}
